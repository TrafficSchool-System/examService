# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/examservicedb
DB_USERNAME=root
DB_PASSWORD=your_secure_password_here

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_minimum_256_bits_long
JWT_EXPIRATION=86400000

# Eureka
EUREKA_URL=http://localhost:8761/eureka/

# Server
SERVER_PORT=8083

# Service API Key for internal service-to-service communication
# VIKTIGT: Måste vara samma i alla services!
SERVICE_API_KEY=your_service_api_key_change_in_production
